# Variables de servidor. Exportarlas antes de ejecutar; .env no se carga automáticamente.
EDU_AI_MODE=local
# Para Gemini: EDU_AI_MODE=gemini, EDU_AI_MODEL=gemini-2.5-flash-lite y clave de Google AI Studio en Render.
# Para IA real: EDU_AI_MODE=openai y EDU_AI_API_KEY en el gestor de secretos.
EDU_AI_MODEL=gpt-4.1-mini
EDU_DATA_DIR=.data
EDU_TESSDATA_DIR=.runtime/tessdata
EDU_COOKIE_SECURE=false
# En despliegue detrás de un proxy: origen público exacto, por ejemplo https://estudio.example.com
EDU_PUBLIC_ORIGIN=
EDU_MAX_FILES=20
EDU_MAX_FILE_MB=10
EDU_MAX_SESSION_MB=50
EDU_MAX_PAGES=30
EDU_MAX_TEXT_CHARS=40000
EDU_MAX_GENERATIONS=10
EDU_MAX_CHAT=60
EDU_MAX_AI_TOKENS=24000
EDU_RETENTION_HOURS=24
EDU_EXTRACTION_WORKERS=2
